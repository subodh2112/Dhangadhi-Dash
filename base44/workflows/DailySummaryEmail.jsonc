{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Katmandu",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_summary_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "daily_summary_email",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send Daily Summary Email",
            "description": "Orders, earnings, top merchants to admin inbox"
          }
        }
      }
    ]
  },
  "description": "Sends a daily summary of all orders, total earnings, and top-performing merchants to admin emails at 9 AM every day.",
  "name": "Daily Summary Email"
}