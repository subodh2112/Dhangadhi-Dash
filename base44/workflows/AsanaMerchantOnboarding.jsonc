{
  "description": "Creates an Asana task automatically when a new merchant application is submitted, to track onboarding progress",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "MerchantApplication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "asana_merchant_onboarding",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "create_asana_task": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "create_asana_merchant_task",
            "args": {
              "application_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Create Asana onboarding task",
            "description": "Creates a task in Asana with merchant application details"
          }
        }
      }
    ]
  },
  "name": "Asana Merchant Onboarding"
}