{
  "name": "LoyaltyWallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "earned_points": {
      "type": "number",
      "default": 0
    },
    "redeemed_points": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "string",
      "enum": [
        "Bronze",
        "Silver",
        "Gold",
        "Platinum",
        "Diamond"
      ],
      "default": "Bronze"
    },
    "total_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}