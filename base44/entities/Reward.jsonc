{
  "name": "Reward",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "level": {
      "type": "string",
      "enum": [
        "Bronze",
        "Silver",
        "Gold",
        "Platinum",
        "Diamond"
      ],
      "default": "Bronze"
    },
    "total_spent": {
      "type": "number"
    },
    "rewards_redeemed": {
      "type": "number"
    },
    "action": {
      "type": "string",
      "enum": [
        "order",
        "referral",
        "review",
        "campaign",
        "signup",
        "redeem"
      ],
      "default": "order"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "points",
        "coupon",
        "cashback",
        "free_delivery"
      ],
      "default": "points"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "customer_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "rider"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}