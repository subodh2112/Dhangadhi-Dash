{
  "name": "RiderIssue",
  "type": "object",
  "properties": {
    "issue_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "rider_id": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "wrong_address",
        "customer_unavailable",
        "merchant_delay",
        "app_issue",
        "payment_issue",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "reported",
        "under_review",
        "resolved",
        "rejected"
      ],
      "default": "reported"
    },
    "resolution": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "issue_type",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}