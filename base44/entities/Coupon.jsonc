{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed",
        "free_delivery"
      ],
      "default": "percentage"
    },
    "discount_value": {
      "type": "number"
    },
    "min_order_amount": {
      "type": "number"
    },
    "max_discount_amount": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "usage_limit": {
      "type": "number"
    },
    "used_count": {
      "type": "number"
    },
    "store_id": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}