{
  "name": "DeliveryRequest",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "rider_id": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "merchant_location": {
      "type": "string"
    },
    "customer_location": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "delivery_fee": {
      "type": "number"
    },
    "order_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "sent_time": {
      "type": "string"
    },
    "response_time": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "distance_km": {
      "type": "number"
    }
  },
  "required": [
    "order_id",
    "rider_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.store_id": "{{user.store_id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.store_id": "{{user.store_id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}