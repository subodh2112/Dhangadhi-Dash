{
  "name": "MerchantSettlement",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "gross_amount": {
      "type": "number"
    },
    "commission_rate": {
      "type": "number"
    },
    "commission_amount": {
      "type": "number"
    },
    "net_amount": {
      "type": "number"
    },
    "settlement_status": {
      "type": "string",
      "enum": [
        "pending",
        "settled",
        "cancelled"
      ],
      "default": "pending"
    },
    "settlement_date": {
      "type": "string"
    }
  },
  "required": [
    "merchant_id",
    "order_id",
    "gross_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.merchant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}