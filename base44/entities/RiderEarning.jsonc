{
  "name": "RiderEarning",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "base_fee": {
      "type": "number"
    },
    "distance_bonus": {
      "type": "number"
    },
    "tip": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "distance_km": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "credited",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "rider_id",
    "order_id",
    "base_fee"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}