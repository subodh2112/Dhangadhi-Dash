{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_type": {
      "type": "string",
      "enum": [
        "customer",
        "merchant",
        "rider",
        "admin"
      ],
      "default": "merchant"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "recipient_store_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_order",
        "order_accepted",
        "rider_assigned",
        "order_delivered",
        "rider_request",
        "general"
      ],
      "default": "general"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "related_order_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "data.recipient_store_id": "{{user.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}