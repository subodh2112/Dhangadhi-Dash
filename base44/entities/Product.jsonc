{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "default": "food",
      "description": "Legacy category slug for backwards compatibility"
    },
    "parent_category_id": {
      "type": "string",
      "description": "ID of the parent Category record"
    },
    "child_category_id": {
      "type": "string",
      "description": "ID of the child Category record"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "discount_percent": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "rating": {
      "type": "number"
    },
    "reviews_count": {
      "type": "number"
    },
    "stock": {
      "type": "number"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "is_bestseller": {
      "type": "boolean",
      "default": false
    },
    "is_new_arrival": {
      "type": "boolean",
      "default": false
    },
    "is_flash_sale": {
      "type": "boolean",
      "default": false
    },
    "food_type": {
      "type": "string",
      "enum": [
        "veg",
        "non_veg"
      ],
      "default": "veg"
    },
    "is_spicy": {
      "type": "boolean",
      "default": false
    },
    "brand": {
      "type": "string"
    },
    "size_options": {
      "type": "string",
      "description": "Comma-separated sizes e.g. S,M,L,XL"
    },
    "color_options": {
      "type": "string",
      "description": "Comma-separated colors"
    },
    "material": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "warranty": {
      "type": "string"
    },
    "specifications": {
      "type": "string",
      "description": "JSON or text of product specs"
    },
    "dimensions": {
      "type": "string"
    },
    "weight": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "store_name",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.store_id": "{{user.store_id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.store_id": "{{user.store_id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}