{
  "name": "RiderLocation",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "speed": {
      "type": "number"
    },
    "heading": {
      "type": "number"
    },
    "timestamp": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    }
  },
  "required": [
    "rider_id",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": {
      "data.rider_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.rider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}