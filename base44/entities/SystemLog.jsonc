{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "critical",
        "business"
      ],
      "default": "info"
    },
    "user_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "acknowledged",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "event_type",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}