{
  "name": "FraudReport",
  "type": "object",
  "properties": {
    "reported_user_id": {
      "type": "string"
    },
    "reported_user_name": {
      "type": "string"
    },
    "reporter_id": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "customer",
        "merchant",
        "rider"
      ],
      "default": "customer"
    },
    "fraud_type": {
      "type": "string",
      "enum": [
        "fake_refund",
        "multiple_accounts",
        "coupon_abuse",
        "fake_order",
        "wrong_pricing",
        "fake_delivery",
        "location_manipulation",
        "spam_review",
        "other"
      ]
    },
    "reason": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "flagged",
        "investigating",
        "confirmed",
        "dismissed",
        "action_taken"
      ],
      "default": "flagged"
    },
    "admin_action": {
      "type": "string"
    }
  },
  "required": [
    "reported_user_id",
    "fraud_type",
    "reason"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}