{
  "name": "Advertisement",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "sponsored_store",
        "featured_product",
        "top_search"
      ],
      "default": "sponsored_store"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "duration_days": {
      "type": "number"
    },
    "cost": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "pending"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "priority": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "merchant_id",
    "campaign_type",
    "cost"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.merchant_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.merchant_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.merchant_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}