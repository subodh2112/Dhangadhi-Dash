{
  "name": "FAQ",
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "customer",
        "merchant",
        "rider",
        "all"
      ],
      "default": "all"
    },
    "category": {
      "type": "string"
    },
    "helpful_count": {
      "type": "number",
      "default": 0
    },
    "not_helpful_count": {
      "type": "number",
      "default": 0
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}