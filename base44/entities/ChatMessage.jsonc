{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "rider",
        "merchant",
        "admin"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_id",
    "sender_id",
    "sender_type",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.order_id": {
            "$in": [
              "{{user.id}}",
              "{{user.rider_id}}",
              "{{user.store_id}}",
              "{{user.merchant_id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}