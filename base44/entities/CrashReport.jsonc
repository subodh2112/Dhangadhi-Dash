{
  "name": "CrashReport",
  "type": "object",
  "properties": {
    "error_message": {
      "type": "string"
    },
    "stack_trace": {
      "type": "string"
    },
    "component_stack": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "device_info": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "high"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "investigated",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "error_message"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}