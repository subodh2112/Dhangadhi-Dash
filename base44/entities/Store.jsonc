{
  "name": "Store",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "store_code": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "merchant_code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "default": "restaurant"
    },
    "description": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "reviews_count": {
      "type": "number"
    },
    "delivery_minutes": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "delivery_radius": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "media_gallery": {
      "type": "string",
      "description": "JSON array of media items: [{url, type, caption}]"
    },
    "is_open": {
      "type": "boolean",
      "default": true
    },
    "is_verified": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_suspended": {
      "type": "boolean",
      "default": false
    },
    "vacation_mode": {
      "type": "boolean",
      "default": false
    },
    "pause_orders": {
      "type": "boolean",
      "default": false
    },
    "free_delivery": {
      "type": "boolean",
      "default": false
    },
    "min_order": {
      "type": "number"
    },
    "distance_km": {
      "type": "number"
    },
    "opening_hours": {
      "type": "string"
    },
    "opening_time": {
      "type": "string"
    },
    "closing_time": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "tags": {
      "type": "string"
    },
    "has_discount": {
      "type": "boolean",
      "default": false
    },
    "owner_name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.merchant_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "merchant"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}